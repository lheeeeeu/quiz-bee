# ====================================================================
# QUIZ BEE COMPETITION SYSTEM - ENVIRONMENT CONFIGURATION EXAMPLE
# Copy this file to .env for local development.
# NEVER commit .env or put secret keys inside VITE_* variables.
# ====================================================================

# --- BACKEND (Google Cloud Run / Local Node Server) ---
PORT=3001
ADMIN_PASSCODE=CHANGE_ME_STRONG_PASSCODE

# Comma-separated allowed frontend origins for CORS (Express + Socket.IO)
# Example for Cloud Run: https://your-project.vercel.app,http://localhost:5173
CORS_ORIGIN=*

# Supabase Cloud Database (Source of Truth in Production)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Optional: Server-side Supabase Secret / Service Role Key (NEVER prefix with VITE_)
# SUPABASE_SECRET_KEY=

# Optional: Override local SQLite cache path (Cloud Run automatically uses /tmp/quizbee.db)
# SQLITE_DB_PATH=/tmp/quizbee.db

# --- FRONTEND (Vercel Environment Variables) ---
# Set this in Vercel to your deployed Cloud Run URL (leave blank for local dev):
# VITE_API_URL=https://quiz-bee-backend-xxxxx-as.a.run.app
VITE_API_URL=
